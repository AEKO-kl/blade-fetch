{

"logo": {
  "type": "file",
  "source": "__HOME__/.config/fastfetch/ascii.txt",
  "padding": {
    "right": 4
  }
},
  "display": {
    "separator": " ",
    "constants": [
      "─────────────────",
      "│",
      " "
    ],
    "key": {
      "width": 12
    }
  },
  "modules": [
  

    {
      "type": "custom",
      "format": "───────────────┬─────────────────────────────────┐"
    },




    {
      "type": "custom",
      "format": "      ⛩        │          「Terminal」           │"
    },



     {
      "type": "custom",//break
      "format": "{#90}───────────────┴─────────────────────────────────┤{#}"
    },




    {
     "type": "custom", // MEOWStart
     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌──────────┤{#}{##FA239B}Welcome back!{#}{#90}├──────────┐{#}            {#90}│{#}"
    },    

   // "break",
    {
      "type": "title", // User name and host
      "key": "User:",
      "format": "{##94E2D5}{user-name}{#}{##94E2D5}@{#}{##94E2D5}{host-name<19} {#}{#90}│{#}            {#90}│{#}"

      //"format": "{user-name}{#90}@{#}{host-name<25}{#}{#90}│{#}",
 
 //     "format": "{user-name}{@}{host-name<35} {#90}│{#}"

    },
  //  "break",
    {
            "type": "custom", // MEOW End
            "format": "{#90}└───────────────────────────────────┘{#}            {#90}│{#}"
    },



    {
      "type": "custom",//break
      "format": "                                                 {#90}│{#}"
    },



       {
     "type": "custom", // Soft and Hardware Start
     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌──────────┤{#}{##FA239B}Soft-and Hardware{#}{#90}├───────────┐       {#90}│{#}{#}"
    },    
    {
      "type": "os",
      "key": "OS:",
      "keyColor": "#89DCEB",
      "format": "{name} {version} {codename} {arch<9} {#90}│{#}       {#90}│{#}" // arch<9 == 9 spaces behind it otherwise cut off...

    },
    {
      "type": "cpu",
      "key": "CPU:",
      "showPeCoreCount": true,
      "keyColor": "#F5C2E7",
      "format": "{name<29} {#90}│{#}       {#90}│{#}"
    },
    {
      "type": "bios",
      "key": "BIOS:",
      "keyColor": "#FAB387",
      "format": "{version<29} {#90}│{#}       {#90}│{#}"
    },
    {
      "type": "gpu",
      "key": "GPU:",
      "keyColor": "#FAB387",
      "format": "{name<24}      {#90}│{#}       {#90}│{#}" // somespacing was added manually here, since
                                           // it prduces two lines, given integrated and dedicated GPU...
    },
    {
      "type": "memory",
      "key": "MEMORY:",
      "keyColor": "#A6E3A1",
      "format": "{used} / {total<16} {#}  {#90}│{#}       {#90}│{#}" // here as well
    },
    {
      "type": "disk",
      "key": "DISK:",
      "keyColor": "#94E2D5",
      "format": "{size-used>10} / {size-total>10}       {#90}│{#}       {#90}│{#}"
    },
    {
            "type": "custom", // End Hardware
            "format": "{#90}└────────────────────────────────────────┘{#}       {#90}│{#}"
    },
    
    {
  "type": "custom", //break
  "format": "                                                 {#90}│{#}"
},

    {
     "type": "custom", // Extra Information Start
     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌──────┤{#}{##FA239B}Intelligence Agency(I.A){#}{#90}├────────┐{#}       {#90}│{#}"
    },    

    {
      "type": "Users",
      "key": "LOGIN:",
      "keyColor": "#89DCEB",
      "format": "{name}: {login-time<20} {#90}   │{#}       {#90}│{#}"
    },
        {
      "type": "Uptime",
      "key": "UPTIME:",
      "keyColor": "#94E2D5",
      "format": "{hours>2} h {minutes>2} min.                  {#90}│{#}       {#90}│{#}" // limiting hours and minutes two min. two sapces, otherwise border gets messed up
    },
        {
      "type": "LocalIp",
      "key": "IP.LOCAL:",
      "keyColor": "#94E2D5",
      "format": "{ipv4<30}{#90}│{#}       {#90}│{#}"
    },
    {
      "type": "DateTime",
      "key": "DATE:",
      "keyColor": "#94E2D5",
      "format": "Date: {day-in-month>2}.{month>2}.{year<18}{#90}│{#}       {#90}│{#}"
      
    },
    {
      "type": "Mouse",
      "key": "Mouse:",
      "keyColor": "#94E2D5",
      "format": "Date: {day-in-month>2}.{month>2}.{year<25}{#90}│{#}       {#90}│{#}", // limit day-in-month for the case of
      "format": "{name<30}{#90}│{#}       {#90}│{#}"                                   // single digit months, in order to keep the frame
    },

        {
            "type": "custom", // End IA
            "format": "{#90}└────────────────────────────────────────┘{#}       {#90}│{#}"
    },

{
  "type": "custom", //break
  "format": "                                                 {#90}│{#}"
},
        {
      "type": "custom",
      "format": "──────────────────↛  ·𖥸·  ↚──────────────────────┘ "
    },
  ]
}
